#!/bin/bash
#PBS -q F2acc
#PBS -l select=2:ncpus=64:ngpus=2:mpiprocs=2
#PBS -l walltime=03:00:00
#PBS -N hphi_gpu_maxn
#PBS -j oe
cd "$PBS_O_WORKDIR"
module purge
module load intel intel-mpi cuda/12.4
if [ -z "$MKLROOT" ]; then
  for d in /home/app/oneapi/mkl/2022.2.1 /home/app/oneapi/mkl/2022.1.0 /home/app/oneapi/mkl/2022.0.2; do
    [ -d "$d" ] && source "$d/env/vars.sh" && break
  done
fi
PREFIX=$HOME/opt/elpa-2025.06-a100
export LD_LIBRARY_PATH="$PREFIX/lib:$MKLROOT/lib/intel64:$LD_LIBRARY_PATH"
export I_MPI_ADJUST_GATHERV=3
HPHI=$HOME/HPhi-elpa/build_kugui_gpu/src/HPhi
BASE=$HOME/bench_appendix
mkdir -p "$BASE"
echo "GPU_MAXN_START $(date "+%F %T")" >> "$BASE/status_maxn.log"

probe () {
  local tag=$1 model=$2 L=$3 sz=$4
  local d=$BASE/maxn_${tag}
  rm -rf "$d"; mkdir -p "$d"; cd "$d" || return 1
  {
    echo "model = \"$model\""
    echo "method = \"FullDiag\""
    echo "lattice = \"chain\""
    echo "L = $L"
    echo "J = 1.0"
    [ "$model" = "SpinGC" ] && echo "Gamma = 0.5"
    [ -n "$sz" ] && echo "2Sz = $sz"
    echo "outputmode = \"none\""
  } > stan.in
  "$HPHI" -sdry stan.in > sdry.log 2>&1
  printf "Solver 3\nNGPU 2\nExpecMode 1\n" >> calcmod.def
  export OMP_NUM_THREADS=16
  local t0=$SECONDS
  mpirun -n 4 -ppn 2 "$HPHI" -e namelist.def > run.log 2>&1
  echo "tag=$tag rc=$? wall=$((SECONDS-t0))s" >> "$BASE/status_maxn.log"
  cd "$BASE" || return 1
}

probe sgc15_N32768 SpinGC 15 ""
probe spin18_N48620 Spin 18 0
echo ALL_DONE_MAXN >> "$BASE/status_maxn.log"
